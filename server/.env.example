# Server Configuration
PORT=5000

# Max AI build-fix attempts before failing the migration (default: 3).
# ZIP is only downloaded after the project build succeeds.
# MAX_BUILD_FIX_ATTEMPTS=3

# Provider auto-fallback order when the selected provider is exhausted.
# AI_FALLBACK_CHAIN=genai,groq,ollama,openrouter,tokenrouter

# ============================================================
# AI PROVIDER CONFIGURATION
# ============================================================
# Multiple providers are supported. Each provider has its own
# env vars for API keys, base URL, and model. Keys can be
# comma-separated for automatic fallback on quota/rate-limit errors.
# Override fallback model lists with <PREFIX>_MODELS.

# -----------------------------------------------------------
# Provider 1: OpenRouter
# -----------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-your_key1,sk-or-your_key2
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free

# -----------------------------------------------------------
# Provider 2: Google Gemini (GenAI) — OpenAI-compatible endpoint
# -----------------------------------------------------------
# Required: Your Gemini API key(s) — comma-separated for fallback
# GENAI_API_KEY=genapi_1,genapi_2
# GENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Largest first, then next-largest (2.0 / 2.5 flash are retired for new keys)
# GENAI_MODEL=gemini-3.6-flash
# GENAI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# -----------------------------------------------------------
# Provider 3: Ollama Cloud (or local)
# -----------------------------------------------------------
# Cloud: set OLLAMA_API_KEY from https://ollama.com/settings/keys
# Local: OLLAMA_BASE_URL=http://localhost:11434/v1 and OLLAMA_ENABLED=true
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_MODELS=gpt-oss:120b,gpt-oss:20b

# -----------------------------------------------------------
# Provider 4: Groq
# -----------------------------------------------------------
# GROQ_API_KEY=gsk_your_key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=groq/compound
# GROQ_MODELS=groq/compound,allam-2-7b,groq/compound-mini

# -----------------------------------------------------------
# Provider 5: TokenRouter
# -----------------------------------------------------------
# TOKENROUTER_API_KEY=tr-your_key1,tr-your_key2
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# TOKENROUTER_MODEL=deepseek/deepseek-v4-pro-0813-free
# TOKENROUTER_MODELS=deepseek/deepseek-v4-pro-0813-free,qwen/qwen3.8-max-free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
