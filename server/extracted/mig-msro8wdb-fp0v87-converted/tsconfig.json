{
  "compilerOptions": {
    "baseUrl": "./",
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable"
    ],
    "paths": {
      "@app/*": [
        "src/app/*"
      ],
      "@core/*": [
        "src/app/core/*"
      ],
      "@pages/*": [
        "src/app/pages/*"
      ],
      "@store/*": [
        "src/app/store/*"
      ],
      "@env/*": [
        "src/environments/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@configs/*": [
        "src/app/config/*"
      ],
      "@/*": [
        "src/*"
      ]
    }
  }
}
